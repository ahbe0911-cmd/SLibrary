<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set><objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" android:duration="85"/>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" android:duration="85"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" android:duration="85"/></set>
    </item>
    <item><set><objectAnimator android:propertyName="translationZ" android:valueTo="2dp" android:valueType="floatType" android:duration="120"/>
        <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="120"/>
        <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="120"/></set></item>
</selector>