<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item android:top="2dp"><shape><corners android:radius="24dp"/><solid android:color="#064E3B"/></shape></item>
            <item android:bottom="3dp">
                <shape><corners android:radius="24dp"/><gradient android:angle="270" android:startColor="#258B70" android:centerColor="#08765A" android:endColor="#065F46"/><stroke android:width="1dp" android:color="#8BD9BB"/></shape>
